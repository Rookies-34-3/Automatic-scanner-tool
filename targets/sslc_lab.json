{
  "target_name": "sslc_lab_qna",
  "base_url": "http://127.0.0.1:8080",
  "verify_tls": true,

  "auth": {
    "type": "form",
    "login_path": "/login",
    "csrf_field": "csrf_token",
    "fields": { "userId": "student1", "password": "Lab1234!" },
    "success_check_path": "/my-class/board/write/qna"
  },
  "attacker_auth": {
    "type": "form",
    "login_path": "/login",
    "csrf_field": "csrf_token",
    "fields": { "userId": "student2", "password": "Lab1234!" },
    "success_check_path": "/my-class/board/write/qna"
  },
  "admin_auth": {
    "type": "form",
    "login_path": "/login",
    "csrf_field": "csrf_token",
    "fields": { "userId": "admin", "password": "Lab1234!" },
    "success_check_path": "/my-class/board/write/qna"
  },

  "upload": {
    "path": "/my-class/board/write/qna",
    "method": "POST",
    "csrf_field": "csrf_token",
    "csrf_from": "/my-class/board/write/qna",
    "file_field": "file",
    "extra_fields": { "title": "scan", "body": "scan" },
    "success_indicators": ["/board/qna/"],
    "allowed_extensions": [".pdf",".txt",".zip",".doc",".docx",".ppt",".pptx",".xls",".xlsx",".hwp",".hwpx",".rtf",".png",".jpg",".jpeg",".gif",".webp"],
    "download_link_regex": "/download/\\d+"
  },

  "download": {
    "url_template": "/download/{id}",
    "id_type": "int",
    "id_range": [1, 40],
    "traversal_template": "/download/{payload}"
  },

  "access_control": {
    "restricted_path": "/my-class/board/write/notice",
    "csrf_from": "/my-class/board/write/qna",
    "file_field": "file",
    "extra_fields": { "title": "fio-bac", "body": "fio" },
    "success_indicators": ["/board/notice/"]
  }
}
