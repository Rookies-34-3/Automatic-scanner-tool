{
  "target_name": "sslc_lab_notice_admin",
  "base_url": "http://127.0.0.1:8080",
  "verify_tls": true,

  "_comment": "공지(notice)는 관리자 전용 업로드. 업로드 '기능 자체'의 검증을 admin 세션으로 진단한다. 다운로드는 전역 /download/{id} 라 qna 타깃의 IDOR 결과와 동일하므로 여기서는 생략.",

  "auth": {
    "type": "form",
    "login_path": "/login",
    "csrf_field": "csrf_token",
    "fields": { "userId": "admin", "password": "Lab1234!" },
    "success_check_path": "/my-class/board/write/notice"
  },

  "upload": {
    "path": "/my-class/board/write/notice",
    "method": "POST",
    "csrf_field": "csrf_token",
    "csrf_from": "/my-class/board/write/notice",
    "file_field": "file",
    "extra_fields": { "title": "scan", "body": "scan" },
    "success_indicators": ["/board/notice/"],
    "allowed_extensions": [".pdf",".txt",".zip",".doc",".docx",".ppt",".pptx",".xls",".xlsx",".hwp",".hwpx",".rtf",".png",".jpg",".jpeg",".gif",".webp"],
    "download_link_regex": "/download/\\d+"
  }
}
