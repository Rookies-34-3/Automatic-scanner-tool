        "username",
        "email",
        "phone"
      ],
      "check_anonymous": true
    },
    {
      "name": "비밀 문의 권한 검증 누락",
      "method": "GET",
      "path": "/customer/contact/{inquiry_id}",
      "owner_account": "other_user",
      "attacker_account": "owner",
      "discovery": {
        "path": "/customer/contact",
        "regex": "href=\"/customer/contact/(?P<inquiry_id>\\d+)",
        "variable": "inquiry_id"
      },
      "check_anonymous": true
