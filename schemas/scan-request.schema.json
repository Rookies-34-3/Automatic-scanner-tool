{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rookiescan.local/schemas/scan-request.schema.json",
  "title": "ROOKIESCAN Scan Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scan_id",
    "target",
    "authorization",
    "auth_profile_ref",
    "selected_modules",
    "endpoints",
    "options"
  ],
  "properties": {
    "scan_id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "base_url", "allowed_paths"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "base_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "allowed_paths": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "note"],
      "properties": {
        "confirmed": {"const": true},
        "note": {"type": "string"}
      }
    },
    "auth_profile_ref": {
      "type": ["string", "null"]
    },
    "selected_modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["sqli", "xss", "fileio", "authn", "authz", "ssrf"]
      }
    },
    "endpoints": {
      "type": "array",
      "items": {"$ref": "#/$defs/endpoint"}
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "max_concurrency", "include_evidence"],
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "max_concurrency": {"type": "integer", "minimum": 1},
        "include_evidence": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint_id", "url", "method", "parameters", "sink_hints"],
      "properties": {
        "endpoint_id": {"type": "string", "minLength": 1},
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "method": {
          "type": "string",
          "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"]
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "location"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "location": {
                "type": "string",
                "enum": ["path", "query", "body", "header", "cookie", "file"]
              }
            }
          }
        },
        "sink_hints": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["database", "html", "file", "authentication", "authorization", "url_request", "unknown"]
          }
        }
      }
    }
  }
}
