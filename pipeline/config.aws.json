{
  "schema_version": "1.1",
  "target": {
    "base_url": "http://13.125.233.51"
  },
  "execution": {
    "parallel": true,
    "scanner_timeout_seconds": 180,
    "output_dir": "pipeline/results",
    "aggregate_file": "aggregate.json"
  },
  "scanners": [
    {
      "id": "authn",
      "enabled": true,
      "config": "authn-scanner/examples/config.aws.json",
      "endpoints": [
        {
          "url": "http://13.125.233.51/admin",
          "method": "GET",
          "parameters": []
        },
        {
          "url": "http://13.125.233.51/my-class/pbl",
          "method": "GET",
          "parameters": []
        }
      ]
    },
    {
      "id": "authz",
      "enabled": true,
      "config": "authz-scanner/examples/config.aws.json",
      "endpoints": [
        {
          "url": "http://13.125.233.51/api/profiles/{user_id}",
          "method": "GET",
          "parameters": [
            {
              "name": "user_id",
              "location": "path"
            }
          ]
        },
        {
          "url": "http://13.125.233.51/customer/contact/{inquiry_id}",
          "method": "GET",
          "parameters": [
            {
              "name": "inquiry_id",
              "location": "path"
            }
          ]
        }
      ]
    },
    {
      "id": "sqli",
      "enabled": true,
      "config": "sqli/config.json",
      "endpoints": [
        {
          "url": "http://13.125.233.51/my-class/board/qna",
          "method": "GET",
          "parameters": [
            {
              "name": "content",
              "location": "query"
            }
          ]
        },
        {
          "url": "http://13.125.233.51/my-class/board/notice",
          "method": "GET",
          "parameters": [
            {
              "name": "content",
              "location": "query"
            }
          ]
        }
      ]
    }
  ]
}
