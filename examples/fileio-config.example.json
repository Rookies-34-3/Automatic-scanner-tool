{
  "base_url": "http://127.0.0.1:8080",
  "sessions": {
    "victim": {
      "cookie_name": "sslc_lab_session",
      "cookie_env": "ROOKIESCAN_VICTIM_SESSION"
    },
    "attacker": {
      "cookie_name": "sslc_lab_session",
      "cookie_env": "ROOKIESCAN_ATTACKER_SESSION"
    }
  },
  "endpoints": [
    {
      "url": "http://127.0.0.1:8080/my-class/board/write/qna",
      "method": "POST",
      "parameters": [{"name": "file", "location": "body"}]
    },
    {
      "url": "http://127.0.0.1:8080/download/{id}",
      "method": "GET",
      "parameters": [{"name": "id", "location": "path"}]
    }
  ],
  "id_range": [1, 200]
}
